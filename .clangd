CompileFlags:
  Add:
    - -Isrc
    - -Isrc/include
    - -Iinclude
    - -I.
    - -Igpu
    - -Igpu/shim
    - -Igpu/shadps4
    - -Igpu/third_party/imgui
    - -Igpu/third_party/imgui/backends
    - -Igpu/third_party/gcn/include
    - -Igpu/third_party/half/include
    - -DWIN32
    - -D_WIN32
    - -D_CRT_SECURE_NO_WARNINGS
    - -DNOMINMAX
    - -DBOOST_ASIO_STANDALONE
  Remove:
    - -std=c11
    - -std=gnu11

---
If:
  PathMatch: .*\.c$
CompileFlags:
  Add:
    - -std=c11

---
If:
  PathMatch: .*\.(cpp|cc|cxx)$
CompileFlags:
  Add:
    - -std=c++20

---
If:
  PathMatch: .*gpu.*\.h$
CompileFlags:
  Add:
    - -std=c++20
    - -x
    - c++-header

---
Diagnostics:
  UnusedIncludes: None
